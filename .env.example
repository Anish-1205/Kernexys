# Local development only. Do not reuse these credentials outside the local stack.
# Replace this placeholder before running Docker Compose. Keep the real .env untracked.
KERNEXYS_POSTGRES_PASSWORD=replace-with-a-random-local-password
KERNEXYS_DATABASE_URL=postgresql+asyncpg://kernexys:replace-with-a-random-local-password@localhost:5432/kernexys
KERNEXYS_LOG_LEVEL=INFO
KERNEXYS_MAX_REQUEST_BYTES=1048576
